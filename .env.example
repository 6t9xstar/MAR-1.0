# MAR 1.0 - Environment Configuration
# Phase 2: CPU-optimized defaults for 8B Q4_K_M GGUF model

# === App ===
APP_NAME=MAR-1.0
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# === Inference (CPU-optimized llama.cpp GGUF) ===
INFERENCE_MODEL=mar-8b
INFERENCE_API_URL=http://localhost:8081/v1
INFERENCE_API_KEY=
MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7
MAX_CONTEXT_LENGTH=32768
STREAMING=true
INFERENCE_REQUEST_TIMEOUT_SECS=120
MAX_CONCURRENT_REQUESTS=4
CPU_THREADS=8
USE_MLOCK=true

# === Database ===
DATABASE_URL=postgres://mar:mar@localhost:5432/mar
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=10

# === Cache (DragonflyDB/Redis) ===
REDIS_URL=redis://localhost:6379

# === Vector DB (Qdrant) ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mar_knowledge
VECTOR_SIZE=1024
SIMILARITY_THRESHOLD=0.75

# === Search (Meilisearch) ===
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_INDEX=mar_knowledge

# === Auth ===
JWT_SECRET=change-me-in-production-use-openssl-rand-64
JWT_EXPIRATION_SECS=86400

# === NLP ===
ENABLE_LANG_DETECTION=true
ENABLE_URDU_NORMALIZATION=true
ENABLE_ROMAN_URDU=true
ENABLE_CODE_SWITCH=true

# === Knowledge ===
KNOWLEDGE_DATA_DIR=./data/knowledge
ENABLE_AUTO_INGEST=true
KNOWLEDGE_CHUNK_SIZE=512
KNOWLEDGE_CHUNK_OVERLAP=64
KNOWLEDGE_MIN_CONFIDENCE=0.7

# === Inference Server (llama.cpp GGUF) ===
MODEL_PATH=models/MAR-8B-Q4_K_M.gguf
MODEL_ALIAS=mar-8b
N_GPU_LAYERS=0
N_CTX=32768
N_BATCH=512
N_THREADS=8
N_PREDICT=4096
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=40
REPEAT_PENALTY=1.1

# === Frontend ===
VITE_API_URL=http://localhost:8080
